rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Datos privados de cada usuario: perfil, tareas, proyectos y metas
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      match /{coleccion}/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Reuniones: las ve el organizador y los invitados (por correo)
    match /reuniones/{id} {
      allow read: if request.auth != null
        && (resource.data.ownerUid == request.auth.uid
            || request.auth.token.email in resource.data.participantes);

      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.participantes is list;

      allow update: if request.auth != null
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == request.auth.uid;

      allow delete: if request.auth != null
        && resource.data.ownerUid == request.auth.uid;
    }
  }
}
